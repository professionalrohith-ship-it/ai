# CODEMIND AI backend configuration.
# Copy this file to ".env" (same folder) and edit it. ".env" is read when the backend starts and is
# never committed. Real environment variables take priority over values in this file.
#
# Scanning, code parsing and dependency analysis work WITHOUT any AI provider. An AI provider is only
# needed for AI chat answers, root-cause analysis in bug investigation and the AI summary in documents.

# ---------------------------------------------------------------- AI provider
# One of: ollama | openai | anthropic | openai_compatible   (leave empty to run without AI)
CODEMIND_AI_PROVIDER=

# Model name as the provider knows it (required when a provider is set).
CODEMIND_AI_MODEL=

# Optional. Defaults: ollama -> http://localhost:11434, openai -> https://api.openai.com/v1,
# anthropic -> https://api.anthropic.com. Required for openai_compatible (LM Studio, vLLM, Groq, OpenRouter...).
CODEMIND_AI_ENDPOINT=

# API key for openai / anthropic / openai_compatible. Not needed for ollama.
# (OPENAI_API_KEY / ANTHROPIC_API_KEY are also accepted for those two providers.)
CODEMIND_AI_API_KEY=

# Optional tuning
# CODEMIND_AI_TIMEOUT=120          # seconds to wait for the model (local models can be slow)
# CODEMIND_AI_MAX_TOKENS=1500      # maximum answer length
# CODEMIND_AI_TEMPERATURE=0.2
# CODEMIND_AI_CONTEXT_CHARS=16000  # how much repository code is sent with each question (use ~8000 for small local models)

# ---------------------------------------------------------------- Examples (copy one block)
# Local model with Ollama (install from https://ollama.com, then:  ollama pull qwen2.5-coder:7b)
#   CODEMIND_AI_PROVIDER=ollama
#   CODEMIND_AI_MODEL=qwen2.5-coder:7b
#
# OpenAI
#   CODEMIND_AI_PROVIDER=openai
#   CODEMIND_AI_MODEL=gpt-4o-mini
#   CODEMIND_AI_API_KEY=sk-...
#
# Anthropic
#   CODEMIND_AI_PROVIDER=anthropic
#   CODEMIND_AI_MODEL=claude-sonnet-4-5
#   CODEMIND_AI_API_KEY=sk-ant-...
#
# Any OpenAI-compatible server (LM Studio shown)
#   CODEMIND_AI_PROVIDER=openai_compatible
#   CODEMIND_AI_ENDPOINT=http://localhost:1234/v1
#   CODEMIND_AI_MODEL=your-model-name

# ---------------------------------------------------------------- Other settings (all optional)
# SQLite database file (default: backend/data/codemind.db, created automatically)
# CODEMIND_DB=C:\Users\you\codemind\codemind.db
# Extra patterns to skip while scanning, comma separated, .gitignore syntax
# CODEMIND_EXCLUDES=*.generated.ts,fixtures/
# Browser origins allowed to call the API (comma separated)
# CODEMIND_CORS=http://localhost:5173,http://127.0.0.1:5173
# Safety limit on files per scan
# CODEMIND_MAX_FILES=500000
